<?xml version="1.0" encoding="utf-8"?>
<!-- Dock button: a dark tile; the chosen one is filled blue (boss: easy to see from the couch). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape><solid android:color="#1E88E5" /><corners android:radius="14dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#2E2F32" /><corners android:radius="14dp" /></shape>
    </item>
</selector>
